# Google AI Studio key. Used by the `feed` module (src/feed) for both text and image generation.
GEMINI_API_KEY=

# Upstash Vector runtime credentials. Read by the `rag` module (src/rag) from Node — pnpm ingest:cvs
# and its retrieval tests — and by the `agent` module (src/agent) via its Worker `env` bindings.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# OpenAI runtime credential for the `agent` module's LLM client (src/agent/clients/llm-client.ts).
# Read by the Worker via its `env` binding, not process.env.
OPENAI_API_KEY=
